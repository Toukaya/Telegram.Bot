<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TelegramBotService/TelegramBotService.csproj" />
    <ProjectReference Include="../TelegramBotService.AI/TelegramBotService.AI.csproj" />
    <ProjectReference Include="../BotDatabase/BotDatabase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

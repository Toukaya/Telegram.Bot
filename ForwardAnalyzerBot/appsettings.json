{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "BotConfiguration": {
    "Storage": {
      "BasePath": "./storage",
      "DatabasePath": "./bot.db",
      "OrganizeByDate": true,
      "OrganizeByType": true,
      "MaxFileSizeMB": 50
    },
    "MediaConversion": {
      "Enabled": true,
      "WhisperPath": "whisper",
      "WhisperModel": "base",
      "TesseractPath": "tesseract",
      "TesseractLanguages": "eng+chi_sim+jpn",
      "FfmpegPath": "ffmpeg",
      "TimeoutSeconds": 300,
      "MaxConcurrent": 2,
      "RetryCount": 3,
      "RetryDelayMs": 1000
    },
    "Memory": {
      "Enabled": false,
      "Backend": "sqlite",
      "EmbeddingProvider": "siliconflow",
      "SqliteStorePath": "./memory.db",
      "QdrantEndpoint": "http://localhost:6333",
      "EmbeddingEndpoint": "https://api.siliconflow.cn/v1",
      "EmbeddingApiKey": "",
      "EmbeddingModel": "BAAI/bge-m3",
      "EmbeddingMaxTokens": 8192
    },
    "Ai": {
      "Enabled": false,
      "Provider": "ollama",
      "Model": "llama3",
      "OllamaEndpoint": "http://localhost:11434",
      "OpenAiApiKey": "",
      "OpenAiModel": "gpt-4o-mini"
    }
  }
}

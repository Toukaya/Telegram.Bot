TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database
DATABASE_PATH=./bot.db

# Media storage (local directory for downloaded media files)
MEDIA_STORAGE_PATH=./media

# Option 1: Use C# plugin system (recommended)
USE_PLUGINS=true
PLUGINS_PATH=./plugins

# Option 2: Use legacy shell scripts (set USE_PLUGINS=false)
# TEXT_SCRIPT_PATH=./analyze_text.sh
# MEDIA_SCRIPT_PATH=./analyze_media.sh

# Media-to-text conversion (optional, requires external tools)
# Set to true to enable automatic media-to-text conversion
ENABLE_MEDIA_CONVERSION=true

# Whisper (for audio/voice transcription)
# Install: pip install openai-whisper
WHISPER_PATH=whisper
WHISPER_MODEL=base

# Tesseract (for image OCR)
# Install: brew install tesseract tesseract-lang (macOS)
#          apt install tesseract-ocr (Ubuntu)
TESSERACT_PATH=tesseract
TESSERACT_LANGUAGES=eng+chi_sim+jpn

# FFmpeg (for video audio extraction)
# Install: brew install ffmpeg (macOS)
#          apt install ffmpeg (Ubuntu)
FFMPEG_PATH=ffmpeg

# Conversion timeout in seconds
CONVERSION_TIMEOUT=300
